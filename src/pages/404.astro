---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

// Served by Workers via `assets.not_found_handling: "404-page"` in
// wrangler.jsonc, with a real 404 status.
---

<BaseLayout
  title="Page not found — Latchpoint"
  description="That page does not exist."
  noindex
>
  <Header />
  <main class="bg-primary text-white">
    <div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
      <p class="font-mono text-sm text-accent">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
        That page does not exist.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-white/80">
        The link may be out of date, or the address may have a typo in it.
      </p>
      <p class="mt-10">
        <a href="/" class="text-accent underline underline-offset-4">
          Go back to the homepage
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
