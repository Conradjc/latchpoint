---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

// Success destination for the inquiry form. Failures go to /sorry/ instead —
// this build is fully static, so a `?error=1` query string cannot change what
// renders here. Astro.url.searchParams is evaluated at build time, not per
// request.
---

<BaseLayout
  title="Thanks — Latchpoint"
  description="Your systems audit request has been received."
  noindex
>
  <Header />
  <main class="bg-primary text-white">
    <div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Got it. Thank you.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-white/80">
        We read every one of these ourselves, and we will reply within one
        business day. If what you described is not something we can help with,
        we will tell you that plainly rather than book a call to find out.
      </p>
      <p class="mt-10">
        <a href="/" class="text-accent underline underline-offset-4">
          Back to the homepage
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
