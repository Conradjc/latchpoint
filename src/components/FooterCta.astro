---
import InquiryForm from './InquiryForm.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-primary-deep text-white">
  <section id="book" class="scroll-mt-8" aria-labelledby="book-heading">
    <div class="mx-auto max-w-2xl px-6 py-20 sm:py-24">
      <div class="text-center">
        <h2
          id="book-heading"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Start with the audit
        </h2>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-white/80">
          It is free, it takes about a week, and you keep the findings whether or
          not we end up working together. Tell me what is going on and I will
          reply within one business day.
        </p>
      </div>

      <InquiryForm />
    </div>
  </section>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-8 text-sm text-white/60 sm:flex-row sm:justify-between"
    >
      <Logo class="text-white/80" />
      <p>&copy; {year} Latchpoint LLC</p>
    </div>
  </div>
</footer>
