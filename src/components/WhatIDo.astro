---
// The mono step numbers are the one sanctioned use of JetBrains Mono on the
// page — the brief reserves it for "code/product bits".
const steps = [
  {
    n: '01',
    title: 'Audit',
    body:
      'A short, focused look at how work actually moves through your business: where things wait, where they get re-entered by hand, where people quietly work around the system.',
  },
  {
    n: '02',
    title: 'Prioritize',
    body:
      'You get two or three opportunities with the highest return, written plainly — what it would save, what it would take, and what it would cost. No roadmap theater.',
  },
  {
    n: '03',
    title: 'Implement',
    body:
      'We build the ones you pick, at a fixed price agreed before the work starts. You know the number up front, and you work with the people who did the audit.',
  },
];
---

<section class="bg-white" aria-labelledby="process-heading">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <h2
      id="process-heading"
      class="text-3xl font-semibold tracking-tight text-primary sm:text-4xl"
    >
      How this works
    </h2>

    <ol class="mt-12 grid gap-10 sm:gap-12 md:grid-cols-3">
      {
        steps.map((step) => (
          <li class="border-t-2 border-accent pt-6">
            <span class="font-mono text-sm text-support">{step.n}</span>
            <h3 class="mt-3 text-xl font-semibold text-primary">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/90">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
