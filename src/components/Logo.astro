---
/*
  Placeholder mark: an open square whose top-right corner is closed by a
  separate amber piece — the latch. Slate carries the form, amber is the spark.
  Intended to be refined later; the geometry here is deliberately simple so it
  survives being rendered at favicon size.
*/
interface Props {
  /** Rendered as a link when true (the header); plain text otherwise. */
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  {...href ? { href } : {}}
  class={`inline-flex items-center gap-2.5 font-semibold tracking-tight ${className}`}
>
  <svg
    viewBox="0 0 32 32"
    class="h-7 w-7 shrink-0"
    fill="none"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M26 19 L26 26 L6 26 L6 6 L19 6" stroke="currentColor" />
    <path d="M19 6 L26 6 L26 19" stroke="var(--color-accent)" />
  </svg>
  <span class="text-xl lowercase">latchpoint</span>
</Tag>
