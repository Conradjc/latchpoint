---
import Logo from './Logo.astro';
import PortalLink from './PortalLink.astro';

// Wordmark left, client portal right. No nav and no second button — the brief
// allows exactly one call to action, so the portal is quiet text aimed at
// existing clients rather than anything that competes with the hero CTA.
---

<header class="bg-primary text-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-6">
    <Logo href="/" class="text-white" />
    <PortalLink href="https://projects.latchpoint.co" />
  </div>
</header>
