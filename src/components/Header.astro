---
import Logo from './Logo.astro';

// Wordmark only. No nav links and no button up here — the brief allows exactly
// one CTA on the page, and putting a second one in the header would compete
// with the hero.
---

<header class="bg-primary text-white">
  <div class="mx-auto flex max-w-5xl items-center px-6 py-6">
    <Logo href="/" class="text-white" />
  </div>
</header>
